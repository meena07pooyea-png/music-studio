# Local development defaults are optional.
NODE_ENV=development
PORT=3001

# Production: use a long random value. Do not commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Production admin account. Change before deploying.
ADMIN_EMAIL=admin@musicstudio.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: only needed when the frontend is hosted on a different origin.
# If frontend and backend are served together, leave blank.
CLIENT_ORIGIN=

# Production persistent disk path on Render.
# Local development can omit this and use server/data/musicstudio.sqlite.
DB_PATH=/var/data/musicstudio.sqlite

# Only needed for a separately hosted frontend.
# VITE_API_URL=https://your-api.example.com
